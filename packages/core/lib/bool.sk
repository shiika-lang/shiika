class Bool
  implement Equatable
    def ==(other: Bool) -> Bool
      (self and other) or (not self and not other)
    end
  end

  implement Hashable
    def hash -> Int
      if self then 1 else 0 end
    end
  end

  def inspect -> String
    if self
      "true"
    else
      "false"
    end
  end

  def to_s -> String
    inspect
  end
end
