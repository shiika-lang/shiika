class Bool : Equatable, Hashable
  def ==(other: Bool) -> Bool
    (self and other) or (not self and not other)
  end

  def hash -> Int
    if self then 1 else 0 end
  end

  def inspect -> String
    if self
      "true"
    else
      "false"
    end
  end

  def to_s -> String
    inspect
  end
end
