# Inherit methods
base class Base1
  def foo -> Int
    1
  end
end

class Sub1 : Base1
end

let sub1 = Sub1.new
unless sub1.foo == 1 then puts "ng 1" end

# Inherit initializer
base class Base2
  def initialize
    let @a = 9
  end
end

base class Mid2 : Base2
end

class Sub2 : Mid2
end

let sub2 = Sub2.new
unless sub2.a == 9 then puts "ng 2" end

# Inherit ivars
base class Base3
  def initialize(i: Int)
    let @a = i
  end
end

class Sub3 : Base3
  def initialize
    let @a = 2
    let @b = 2.0
  end
end

let sub3 = Sub3.new
unless sub3.a == 2 then puts "ng 3" end
unless sub3.b == 2.0 then puts "ng 4" end

# Inherit initializer of a generic class with an immediate type argument
base class Base5<T>
  def initialize(@v: T); end
  def show -> String
    @v.to_s
  end
end
class Sub5Int : Base5<Int>; end
class Sub5Float : Base5<Float>; end
class Sub5Bool : Base5<Bool>; end
unless Sub5Int.new(1).show == "1" then puts "ng 5" end
unless Sub5Int.new(1).v == 1 then puts "ng 6" end
unless Sub5Float.new(1.5).show == "1.5" then puts "ng 7" end
unless Sub5Bool.new(true).v then puts "ng 8" end

