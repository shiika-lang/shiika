module Eq
  requirement eq?(other: Self) -> Bool

  # A default implementation can call a requirement with `Self`
  def neq?(other: Self) -> Bool
    not eq?(other)
  end
end

class Point : Eq
  def initialize(@x: Int, @y: Int); end
  def eq?(other: Point) -> Bool
    @x == other.x and @y == other.y
  end
end

# The requirement is satisfied by the method of the superclass
base class Animal
  def initialize(@name: String); end
  def eq?(other: Animal) -> Bool
    @name == other.name
  end
end
class Dog : Animal, Eq
end

# A subclass of the includer overrides the method (it must accept the includer)
base class Shape : Eq
  def initialize(@n: Int); end
  def eq?(other: Shape) -> Bool
    @n == other.n
  end
end
class Square : Shape
  def eq?(other: Shape) -> Bool
    true
  end
end

# Generic class
class Box<T> : Eq
  def initialize(@v: T); end
  def eq?(other: Box<T>) -> Bool
    true
  end
end

# A module with type parameters
module Holder<X>
  requirement hold(x: X, other: Self) -> X
end
class IntHolder : Holder<Int>
  def hold(x: Int, other: IntHolder) -> Int
    x + 1
  end
end

# Prerequisite module
module Ord : Eq
  requirement lt?(other: Self) -> Bool

  # `self` is `Self`, so it can be passed where `Self` is expected
  def le?(other: Self) -> Bool
    eq?(other) or lt?(other)
  end
  def gt?(other: Self) -> Bool
    other.lt?(self)
  end
end
class Num : Ord, Eq
  def initialize(@n: Int); end
  def eq?(other: Num) -> Bool
    @n == other.n
  end
  def lt?(other: Num) -> Bool
    @n < other.n
  end
end

# Module-typed values
module Named
  requirement name -> String
  requirement same_name?(other: Self) -> Bool
  def me -> Self
    self
  end
  def greeting -> String
    "hello, " + name
  end
end
module Titled : Named
  requirement title -> String
end
class Person : Titled, Named
  def initialize(@name: String); end
  def same_name?(other: Person) -> Bool
    @name == other.name
  end
  def title -> String
    "Dr."
  end
end

class Main
  # Methods without `Self` can be called on a module-typed value
  def self.greet(x: Named) -> String
    x.greeting
  end
  # `Self` in the return type is the module type
  def self.me_name(x: Named) -> String
    x.me.name
  end
  # Via a prerequisite module
  def self.titled_greet(x: Titled) -> String
    x.title + " " + x.me.name
  end

  # Via a typaram: `Self` is `T`
  def self.neq_t<T: Eq>(a: T, b: T) -> Bool
    a.neq?(b)
  end
  # Methods of a prerequisite module via a typaram
  def self.max_t<T: Ord>(a: T, b: T) -> T
    if a.gt?(b) or a.eq?(b) then a else b end
  end
  # Via a typaram whose upper bound is a class: `Self` is the includer
  def self.neq_shape<T: Shape>(a: T, b: Shape) -> Bool
    a.neq?(b)
  end

  def self.run()
    unless Point.new(1, 2).eq?(Point.new(1, 2))
      puts "ng: Point#eq?"
    end
    unless Point.new(1, 2).neq?(Point.new(1, 3))
      puts "ng: Point#neq?"
    end
    if Point.new(1, 2).neq?(Point.new(1, 2))
      puts "ng: Point#neq? (equal)"
    end

    if Dog.new("a").neq?(Dog.new("a"))
      puts "ng: Dog#neq?"
    end
    unless Dog.new("a").neq?(Dog.new("b"))
      puts "ng: Dog#neq? (different)"
    end

    if Square.new(1).neq?(Square.new(2))
      puts "ng: Square#neq?"
    end
    unless Shape.new(1).neq?(Shape.new(2))
      puts "ng: Shape#neq?"
    end

    if Box<Int>.new(1).neq?(Box<Int>.new(2))
      puts "ng: Box#neq?"
    end

    unless IntHolder.new.hold(1, IntHolder.new) == 2
      puts "ng: IntHolder#hold"
    end

    unless Main.neq_t(Point.new(1, 2), Point.new(1, 3))
      puts "ng: neq_t"
    end
    if Main.neq_t(Dog.new("a"), Dog.new("a"))
      puts "ng: neq_t (Dog)"
    end
    unless Main.max_t(Num.new(1), Num.new(2)).n == 2
      puts "ng: max_t"
    end
    unless Main.max_t(Num.new(3), Num.new(2)).n == 3
      puts "ng: max_t (2)"
    end
    unless Num.new(1).le?(Num.new(1))
      puts "ng: Num#le?"
    end
    if Main.neq_shape(Square.new(1), Shape.new(2))
      puts "ng: neq_shape"
    end

    unless Main.greet(Person.new("a")) == "hello, a"
      puts "ng: greet"
    end
    unless Main.me_name(Person.new("b")) == "b"
      puts "ng: me_name"
    end
    unless Main.titled_greet(Person.new("c")) == "Dr. c"
      puts "ng: titled_greet"
    end
  end
end
Main.run
puts "ok"
