# Basic example
class A
  def self.initialize
    let @a = 0
  end
end
if A.a != 0; puts "A.a returned \{A.a}"; end

# Initialized to a non-zero value and read back. (Regression: class ivars used
# to have no real storage and self.initialize was never called, so this read
# uninitialized memory which happened to look like 0 for the case above.)
class NonZero
  def self.initialize
    let @a = 5
  end
end
unless NonZero.a == 5; puts "ng: NonZero.a is \{NonZero.a}"; end

# Multiple class ivars of different types
class Multi
  def self.initialize
    let @n = 42
    let @s = "hello"
  end
end
unless Multi.n == 42; puts "ng: Multi.n"; end
unless Multi.s == "hello"; puts "ng: Multi.s"; end

# Mutable class ivar updated by a class method
class Counter
  def self.initialize
    var @count = 0
  end
  def self.incr
    @count = @count + 1
  end
end
Counter.incr
Counter.incr
unless Counter.count == 2; puts "ng: Counter.count"; end

