# The scope waits for the tasks
var n = 0
Task.scope do |scope|
  scope.spawn do
    sleep_sec(0)
    n += 1
  end
  scope.spawn do
    n += 10
  end
end
unless n == 11; puts "ng: n=\{n}"; end

# A task is not started until the parent task awaits
var started = false
Task.scope do |scope|
  scope.spawn{ started = true }
  if started; puts "ng: task started synchronously"; end
end
unless started; puts "ng: task not started"; end

# Task.scope returns the value of the block
let v = Task.scope<Int>{|scope| 42 }
unless v == 42; puts "ng: v=\{v}"; end

# A task can spawn another task in the same scope
var m = 0
Task.scope do |scope|
  scope.spawn do
    sleep_sec(0)
    scope.spawn do
      sleep_sec(0)
      m += 1
    end
    m += 10
  end
end
unless m == 11; puts "ng: m=\{m}"; end

# Nested scopes
var k = 0
Task.scope do |scope|
  scope.spawn do
    Task.scope do |inner|
      inner.spawn do
        sleep_sec(0)
        k += 1
      end
    end
    unless k == 1; puts "ng: inner scope did not wait"; end
    k += 10
  end
end
unless k == 11; puts "ng: k=\{k}"; end

# Called from a method
class A
  def self.run(xs: Array<Int>) -> Int
    var sum = 0
    Task.scope do |scope|
      xs.each do |x|
        scope.spawn do
          sleep_sec(0)
          sum += x
        end
      end
    end
    sum
  end
end
let sum = A.run([1, 2, 3])
unless sum == 6; puts "ng: sum=\{sum}"; end

# Task#await returns the value of the block
Task.scope do |scope|
  let t1 = scope.spawn do
    sleep_sec(0)
    1
  end
  let t2 = scope.spawn{ "two" }
  let t3 = scope.spawn{ [3.0] }
  unless t2.await == "two"; puts "ng: t2"; end
  unless t1.await == 1; puts "ng: t1"; end
  unless t3.await[0] == 3.0; puts "ng: t3"; end
  # Can be awaited more than once
  unless t1.await + t1.await == 2; puts "ng: t1 (again)"; end
end

# A task can be awaited after its scope is finished
let task = Task.scope<Task<Int>> do |scope|
  scope.spawn do
    sleep_sec(0)
    7
  end
end
unless task.await == 7; puts "ng: task.await=\{task.await}"; end

# A task can be awaited by more than one task
var total = 0
Task.scope do |scope|
  let slow = scope.spawn do
    sleep_sec(0)
    sleep_sec(0)
    5
  end
  scope.spawn{ total += slow.await }
  scope.spawn{ total += slow.await }
  total += slow.await
end
unless total == 15; puts "ng: total=\{total}"; end

puts "ok"
