# while
var i = 0
while i < 3
  i += 1
end
unless i == 3 then puts "ng 1" end

# nested while
i = 0
var j = 0
while i < 1
  i += 1
  while j < 1
    j += 1
  end
end

# while in lambda
[3].each do |n: Int|
  i = 0; while i < n
    i += 1
    break if i == 2
  end
end
unless i == 2 then puts "ng: while in lambda" end

# break
i = 0
while i < 3
  if i == 3 then break end
  if i == 2 then break end
  i += 1
end
unless i == 2 then puts "ng 2" end

# break from block
var n = 0
[1, 2, 3].each{|i: Int|
  n += i
  break if i == 2
  n += i
}
unless n == 4 then puts "ng: break from block" end

# break in match expr
class Issue376
  def self.foo
    loop do
      match 1
      when a
        p a
        break
      end
    end
  end
end

class A
  # return without arguments
  def self.wo_arg
    return if false
    1
  end

  # return without arguments on the end of a method
  def self.wo_arg_end
    return
  end

  # return with an argument
  def self.w_arg -> Int
    return 1 if false
    2
  end

  # return with an argument on the end of a method
  def self.w_arg_end -> Int
    return 1
  end

# #266
#  def self.return_from_block -> Int
#    [1, 2, 3].each do |i: Int|
#      return 99 # Jumps to the end of the lambda, then
#    end         # jumps to the end of `each`, and then
#    return 0    # jumps to the end of the method
#  end

  def self.break_from_fn -> Int
    let f = fn(){ break 1; 2 } # Jumps to the end of this fn
    f()
  end

  # conditional `break x` from a fn
  def self.cond_break_from_fn(cond: Bool) -> Int
    let f = fn(){
      break 1 if cond
      2
    }
    f()
  end

  # `break` from a fn nested inside a `while` escapes only the fn
  def self.break_from_fn_in_while -> Int
    var sum = 0
    var i = 0
    while i < 3
      let f = fn(){ break i * 10; 0 }
      sum += f()
      i += 1
    end
    sum
  end

  # a fn whose body is only `break x` infers its return type from the break
  def self.break_only_fn -> Int
    let f = fn(){ break 7 }
    f()
  end

  # `break x` widens to the fn's return type (Int boxed into Object)
  def self.break_widen_to_object(cond: Bool) -> String
    let f = fn(){
      break 1 if cond
      Object.new
    }
    f().class.name
  end
end
A.wo_arg
A.wo_arg_end
unless A.w_arg == 2; puts "ng w_arg" end
unless A.w_arg_end == 1; puts "ng w_arg_end" end
#unless A.return_from_block == 99; puts "ng return_from_block" end
unless A.break_from_fn == 1; puts "ng break_from_fn" end
unless A.cond_break_from_fn(true) == 1; puts "ng cond_break_from_fn true" end
unless A.cond_break_from_fn(false) == 2; puts "ng cond_break_from_fn false" end
unless A.break_from_fn_in_while == 30; puts "ng break_from_fn_in_while" end
unless A.break_only_fn == 7; puts "ng break_only_fn" end
unless A.break_widen_to_object(true) == "Int"; puts "ng break_widen_to_object true" end
unless A.break_widen_to_object(false) == "Object"; puts "ng break_widen_to_object false" end

# #484 break from lambda in lambda
class Issue484
  def self.run
    let a = Array<String>.new
    "he\nllo".each_char do |b|
      break if b == "\n"
      a.push(b)
    end
    unless a == ["h", "e"]; puts "ng Issue484"; end
  end
end
Issue484.run

puts "ok"
